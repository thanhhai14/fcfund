{
  "name": "fcfund",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:teams": "tsx scripts/test-team-balancer.ts",
    "test:matches": "tsx scripts/test-match-lifecycle.ts",
