    "audit:matches:prd": "tsx --env-file=.env.production.local scripts/audit-match-lifecycle.ts",
    "repair:matches": "tsx --env-file=.env.local scripts/repair-match-lifecycle.ts",
    "repair:matches:prd": "tsx --env-file=.env.production.local scripts/repair-match-lifecycle.ts",
    "test:teams:live": "tsx scripts/test-team-balancer-live.ts",
    "test:zalo-match:live": "tsx scripts/test-zalo-name-matching-live.ts",
    "test:zalo-match:prd": "tsx --env-file=.env.production.local scripts/test-zalo-name-matching-live.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "latest",
    "@fortawesome/free-solid-svg-icons": "latest",
