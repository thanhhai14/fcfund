    "@vercel/blob": "latest",
    "bcryptjs": "latest",
    "drizzle-orm": "latest",
    "html-to-image": "^1.11.13",
    "jose": "latest",
    "next": "^16.3.5",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "puppeteer-core": "^25.4.0",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
